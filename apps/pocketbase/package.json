{
  "name": "pocketbase-app",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "pocketbase.exe serve --http=0.0.0.0:8090 --hooksWatch=false",
    "start": "pocketbase.exe serve --http=0.0.0.0:8090 --encryptionEnv=PB_ENCRYPTION_KEY --dir=%cd%\\pb_data --migrationsDir=pb_migrations --hooksDir=pb_hooks --hooksWatch=false",
    "migrations:up": "pocketbase.exe horizons migrations:up --encryptionEnv=PB_ENCRYPTION_KEY --dir=pb_data --migrationsDir=pb_migrations --hooksDir=pb_hooks --hooksWatch=false",
    "migrations:revert": "pocketbase.exe horizons migrations:revert --encryptionEnv=PB_ENCRYPTION_KEY --dir=pb_data --migrationsDir=pb_migrations --hooksDir=pb_hooks --hooksWatch=false",
    "migrations:snapshot": "if not exist pb_snapshots mkdir pb_snapshots && pocketbase.exe migrate collections --encryptionEnv=PB_ENCRYPTION_KEY --dir=pb_data --migrationsDir=pb_snapshots",
    "update": "pocketbase.exe update --encryptionEnv=PB_ENCRYPTION_KEY --backup=0"
  }
}
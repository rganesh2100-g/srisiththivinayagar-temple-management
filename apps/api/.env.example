# ═══════════════════════════════════════════════════════════════════════════════
# Sri Siththi Vinayagar Temple — API Environment Variables
# Copy this file to .env and fill in the values
# ═══════════════════════════════════════════════════════════════════════════════

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ─── CORS ────────────────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:3000

# ─── PocketBase (existing — kept during migration) ───────────────────────────
POCKETBASE_URL=http://localhost:8090
PB_SUPERUSER_EMAIL=admin@localhost.com
PB_SUPERUSER_PASSWORD=admin123456

# ─── PostgreSQL ──────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://vinayagar:password@localhost:5432/vinayagar_dev"

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_SECRET="REPLACE-WITH-A-64-CHARACTER-RANDOM-STRING-FOR-SIGNING-TOKENS"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"
JWT_ISSUER="vinayagar-temple"

# ─── Storage ─────────────────────────────────────────────────────────────────
STORAGE_BASE_PATH="uploads"
STORAGE_MAX_FILE_SIZE=10485760

# ─── Email (Nodemailer SMTP) ────────────────────────────────────────────────
EMAIL_SERVICE_TYPE=nodemailer
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM_EMAIL=your_email@gmail.com
SMTP_FROM_NAME=Sri Sithivinayagar Temple

# ─── Google OAuth ────────────────────────────────────────────────────────────
GOOGLE_OAUTH_CLIENT_ID=your_google_oauth_client_id_here
GOOGLE_OAUTH_CLIENT_SECRET=your_google_oauth_client_secret_here
